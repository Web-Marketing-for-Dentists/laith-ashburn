---
interface Props {
  before?: string;
  after?: string;
  beforeLabel?: string;
  afterLabel?: string;
  alt?: string;
}
const {
  before = "/assets/images/implant-before.jpg",
  after = "/assets/images/implant-after.jpg",
  beforeLabel = "Before",
  afterLabel = "After",
  alt = "Before and after dental treatment",
} = Astro.props;
---
<div
  class="bas-container"
  data-bas
  data-before-image={before}
  data-after-image={after}
  data-before-label={beforeLabel}
  data-after-label={afterLabel}
  role="img"
  aria-label={alt}
></div>

<script>
  // @ts-nocheck -- vendored verbatim from before-after-slider.js; kept untyped to stay in sync with the source component.
  // ---- BeforeAfterSlider (also available as before-after-slider.js) ----
  (function (global) {
    'use strict';

    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function BeforeAfterSlider(selector, options) {
      var el = typeof selector === 'string' ? document.querySelector(selector) : selector;
      if (!el) {
        throw new Error('BeforeAfterSlider: container not found for "' + selector + '"');
      }

      var opts = Object.assign(
        {
          beforeImage: '',
          afterImage: '',
          beforeLabel: 'Before',
          afterLabel: 'After',
          startPosition: 50,
          autoSlide: true,
          autoSlideSpeed: 1400,
          autoSlideSweeps: 3,
          autoSlideRange: [15, 85]
        },
        options || {}
      );

      this.el = el;
      this.opts = opts;
      this.position = clamp(opts.startPosition, 0, 100);
      this.dragging = false;
      this.autoTimer = null;
      this.stopped = false;

      this._buildDom();
      this._bindEvents();
      this.setPosition(this.position);

      if (opts.autoSlide) {
        this._startAutoSlide();
      }
    }

    BeforeAfterSlider.prototype._buildDom = function () {
      var el = this.el;
      el.classList.add('bas-container');
      el.innerHTML = '';

      var after = document.createElement('div');
      after.className = 'bas-image bas-image--after';
      after.style.backgroundImage = 'url("' + this.opts.afterImage + '")';

      var afterLabel = document.createElement('span');
      afterLabel.className = 'bas-label bas-label--after';
      afterLabel.textContent = this.opts.afterLabel;
      after.appendChild(afterLabel);

      var before = document.createElement('div');
      before.className = 'bas-image bas-image--before';
      before.style.backgroundImage = 'url("' + this.opts.beforeImage + '")';

      var beforeLabel = document.createElement('span');
      beforeLabel.className = 'bas-label bas-label--before';
      beforeLabel.textContent = this.opts.beforeLabel;
      before.appendChild(beforeLabel);

      var handle = document.createElement('div');
      handle.className = 'bas-handle';
      var grip = document.createElement('div');
      grip.className = 'bas-handle-grip';
      handle.appendChild(grip);

      el.appendChild(after);
      el.appendChild(before);
      el.appendChild(handle);

      this.beforeEl = before;
      this.handleEl = handle;
    };

    BeforeAfterSlider.prototype._bindEvents = function () {
      var self = this;

      function onPointerDown(e) {
        self._stopAutoSlide();
        self.dragging = true;
        self._updateFromEvent(e);
      }

      function onPointerMove(e) {
        if (!self.dragging) return;
        self._updateFromEvent(e);
      }

      function onPointerUp() {
        self.dragging = false;
      }

      this.el.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);

      this.el.addEventListener('touchstart', onPointerDown, { passive: true });
      window.addEventListener('touchmove', onPointerMove, { passive: true });
      window.addEventListener('touchend', onPointerUp);

      this.el.addEventListener('click', function () {
        self._stopAutoSlide();
      });
    };

    BeforeAfterSlider.prototype._updateFromEvent = function (e) {
      var rect = this.el.getBoundingClientRect();
      var clientX = e.touches && e.touches.length ? e.touches[0].clientX : e.clientX;
      var pct = ((clientX - rect.left) / rect.width) * 100;
      this.setPosition(pct);
    };

    BeforeAfterSlider.prototype.setPosition = function (pct) {
      this.position = clamp(pct, 0, 100);
      this.beforeEl.style.clipPath = 'inset(0 ' + (100 - this.position) + '% 0 0)';
      this.handleEl.style.left = this.position + '%';
    };

    BeforeAfterSlider.prototype._startAutoSlide = function () {
      var self = this;
      var range = this.opts.autoSlideRange;
      var speed = this.opts.autoSlideSpeed;
      var sweepsRemaining = this.opts.autoSlideSweeps * 2;
      var goingRight = true;

      function animateStep(fromPct, toPct, duration, onDone) {
        var start = null;

        function frame(timestamp) {
          if (self.stopped) return;
          if (start === null) start = timestamp;
          var elapsed = timestamp - start;
          var t = clamp(elapsed / duration, 0, 1);
          var eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          self.setPosition(fromPct + (toPct - fromPct) * eased);

          if (t < 1) {
            self.autoTimer = requestAnimationFrame(frame);
          } else if (onDone) {
            onDone();
          }
        }

        self.autoTimer = requestAnimationFrame(frame);
      }

      function next() {
        if (self.stopped || sweepsRemaining <= 0) {
          self.autoTimer = null;
          return;
        }
        var from = goingRight ? range[0] : range[1];
        var to = goingRight ? range[1] : range[0];
        animateStep(from, to, speed, function () {
          goingRight = !goingRight;
          sweepsRemaining -= 1;
          next();
        });
      }

      this.setPosition(range[0]);
      goingRight = true;
      next();
    };

    BeforeAfterSlider.prototype._stopAutoSlide = function () {
      if (this.stopped) return;
      this.stopped = true;
      if (this.autoTimer) {
        cancelAnimationFrame(this.autoTimer);
        this.autoTimer = null;
      }
    };

    global.BeforeAfterSlider = BeforeAfterSlider;
  })(window);

  // ---- Init every slider rendered on the page ----
  document.querySelectorAll('[data-bas]').forEach((el) => {
    new window.BeforeAfterSlider(el, {
      beforeImage: el.dataset.beforeImage,
      afterImage: el.dataset.afterImage,
      beforeLabel: el.dataset.beforeLabel,
      afterLabel: el.dataset.afterLabel,
      autoSlide: true,
      autoSlideSpeed: 2400,
      autoSlideSweeps: 3
    });
  });
</script>

<style is:global>
  /* ---- Before/After slider styles (also available as before-after-slider.css) ---- */

  .bas-container {
    position: relative;
    width: 100%;
    max-width: 700px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    user-select: none;
    touch-action: none;
    cursor: ew-resize;
  }

  .bas-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .bas-image--after {
    z-index: 1;
  }

  .bas-image--before {
    z-index: 2;
  }

  .bas-label {
    position: absolute;
    top: 16px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    border-radius: 999px;
    white-space: nowrap;
    pointer-events: none;
  }

  .bas-label--before {
    left: 16px;
  }

  .bas-label--after {
    right: 16px;
  }

  .bas-handle {
    position: absolute;
    top: 0;
    height: 100%;
    width: 2px;
    background: #fff;
    transform: translateX(-1px);
    z-index: 3;
    pointer-events: none;
  }

  .bas-handle-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .bas-handle-grip::before,
  .bas-handle-grip::after {
    content: "";
    width: 0;
    height: 0;
    border-style: solid;
  }

  .bas-handle-grip::before {
    border-width: 5px 7px 5px 0;
    border-color: transparent #555 transparent transparent;
  }

  .bas-handle-grip::after {
    border-width: 5px 0 5px 7px;
    border-color: transparent transparent transparent #555;
  }
</style>
