---
import { procedureOptions, resolveProcedure, site } from "@/utils/site";
const procedure = resolveProcedure(Astro.url.searchParams.get("interest"));
---
<form id="book-consultation" name="book-consultation" data-whatconverts-form="book-consultation" class="appointment-form" novalidate>
  <div class="appointment-form__grid">
    <label><span>Name <b aria-hidden="true">*</b></span><input required name="Name" data-whatconverts-field="name" autocomplete="name" placeholder="Full Name" /></label>
    <label><span>Phone <b aria-hidden="true">*</b></span><input required type="tel" inputmode="tel" name="Phone" data-whatconverts-field="phone" autocomplete="tel-national" placeholder="Phone" /></label>
    <label><span>Email <b aria-hidden="true">*</b></span><input required type="email" name="Email" data-whatconverts-field="email" autocomplete="email" placeholder="Email" /></label>
    <label><span>Procedure</span><select name="Procedure" data-whatconverts-field="procedure">{procedureOptions.map((item) => <option selected={item === procedure} value={item}>{item}</option>)}</select></label>
  </div>
  <label><span>Message</span><textarea name="Message" data-whatconverts-field="message" placeholder="Message"></textarea></label>
  <label class="checkbox"><input type="checkbox" name="A2P" data-whatconverts-field="a2p" /><span>I agree that {site.name} may contact me by phone or text about this request. Message and data rates may apply.</span></label>
  <input type="hidden" name="Form ID" value="book-consultation" />
  <input type="hidden" name="Page URL" value={Astro.url.href} />
  <p class="appointment-form__error" data-error role="alert" hidden></p>
  <button class="button" type="submit">Request an appointment</button>
  <p class="appointment-form__id">Form ID: <strong>book-consultation</strong></p>
</form>

<script is:inline define:vars={{ fallbackPhone: site.phoneDisplay, fallbackHref: site.phoneHref }}>
  const form = document.querySelector('#book-consultation');
  const error = form?.querySelector('[data-error]');
  const formatPhone = (value) => {
    let digits = value.replace(/\D/g, ''); if (digits.startsWith('1')) digits = digits.slice(1); digits = digits.slice(0, 10);
    if (digits.length <= 3) return digits ? `(${digits}` : ''; if (digits.length <= 6) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
    return `(${digits.slice(0,3)}) ${digits.slice(3,6)}-${digits.slice(6)}`;
  };
  form?.querySelector('[name="Phone"]')?.addEventListener('input', (event) => event.target.value = formatPhone(event.target.value));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = Object.fromEntries(new FormData(form));
    const phoneDigits = String(values.Phone || '').replace(/\D/g, '').replace(/^1/, '');
    const validPhone = /^[2-9]\d{2}[2-9]\d{2}\d{4}$/.test(phoneDigits);
    const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(values.Email || ''));
    if (!String(values.Name || '').trim() || !validPhone || !validEmail) {
      if (error) { error.hidden = false; error.textContent = 'Please provide your name, a valid U.S. phone number, and a valid email address.'; }
      return;
    }
    if (error) error.hidden = true;
    const button = form.querySelector('button'); if (button) { button.disabled = true; button.textContent = 'Sending request…'; }
    try {
      const response = await fetch('/api/appointment-request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(values) });
      if (!response.ok) {
        // Keep the message to the patient friendly, but make the real cause visible in the console.
        const body = await response.json().catch(() => ({}));
        console.error('[book-consultation] submission failed —', response.status, body.error || '', body.detail || '');
        throw new Error('Request failed');
      }
      const activeDisplay = document.querySelector('[data-phone-display]')?.textContent?.trim() || fallbackPhone;
      const activeHref = document.querySelector('[data-phone-link]')?.getAttribute('href') || fallbackHref;
      form.outerHTML = `<section class="appointment-success" role="status"><p class="eyebrow">Request received</p><h2>Thank you for reaching out.</h2><p>We sent a confirmation to your email and shared your request with the My Ashburn Dentist team. A team member will contact you shortly.</p><a data-phone-sync href="${activeHref}">Call us now: <span data-phone-display>${activeDisplay}</span></a></section>`;
    } catch {
      if (button) { button.disabled = false; button.textContent = 'Request an appointment'; }
      if (error) { error.hidden = false; error.textContent = 'We could not send your request right now. Please call our office.'; }
    }
  });
</script>

<style>
  .appointment-form { display: grid; gap: 1.25rem; }
  .appointment-form__grid { display: grid; gap: 1.25rem; }
  label { display: grid; gap: .55rem; color: var(--ink); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  label > span { display: inline-flex; align-items: center; gap: .25rem; white-space: nowrap; }
  b { color: #9b3f49; }
  input, select, textarea { width: 100%; border: 1px solid var(--line); border-radius: 0; background: var(--white); color: var(--ink); padding: .85rem 1rem; font-size: 1rem; font-weight: 400; letter-spacing: normal; text-transform: none; }
  textarea { min-height: 8.5rem; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--rose); outline-offset: 1px; }
  .checkbox { grid-template-columns: auto 1fr; align-items: start; color: var(--ink-soft); font-size: .95rem; font-weight: 400; letter-spacing: normal; line-height: 1.5; text-transform: none; }
  .checkbox input { width: 1rem; height: 1rem; margin-top: .22rem; }
  .appointment-form__error { margin: 0; border-left: 3px solid #9b3f49; color: #9b3f49; padding-left: .75rem; }
  .appointment-form__id { margin: 0; color: #5e6e76; font-size: .8rem; }
  .appointment-success { border: 1px solid var(--line); background: var(--rose); padding: 2.5rem; }
  .appointment-success h2 { margin: 1rem 0; font-family: var(--font-display); font-size: 3rem; line-height: .95; }
  .appointment-success a { display: inline-block; margin-top: 1.5rem; border-bottom: 1px solid var(--ink); color: var(--ink); font-size: .75rem; font-weight: 800; letter-spacing: .12em; padding-bottom: .25rem; text-decoration: none; text-transform: uppercase; }
  @media (min-width: 44rem) { .appointment-form__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
